  "info": {
    "_postman_id": "6ecf8028-a348-4e39-aaff-a63efb4f341a",
    "name": "Helidon Observe ( & ) Health Metrics API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Helidon provides built-in observability endpoints following the MicroProfile Health and MicroProfile Metrics specifications. These endpoints expose application health status, readiness, liveness, startup checks, and application/vendor/base metrics. In Helidon 4.x, these are served under the /observe path by default.\n\nContact Support:\n Name: Helidon Team",
      "type": "text/plain"
    }
